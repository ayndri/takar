# Salin jadi .env lalu isi nilainya sendiri.

# Neon Postgres — pooled, dipakai aplikasi saat runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct (tanpa -pooler), dipakai `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3001
JWT_SECRET="string-acak-minimal-32-karakter"
CORS_ORIGIN="http://localhost:3000"

# Midtrans. Ambil dari dashboard.midtrans.com → Settings → Access Keys,
# pastikan sakelar lingkungannya di Sandbox (kuncinya berawalan SB-).
# Dikosongkan berarti pembayaran online mati; sisa aplikasi tetap jalan.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
